/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "we-learning-suite-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-02",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],

	// R2 对象存储绑定 —— 存储文件本体
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "we-learning-suite"
		}
	],

	// D1 数据库绑定 —— 存储文件元数据
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "we-learning-suite",
			"database_id": "7d4d5368-03af-4bfe-9a17-92a6cff2ebf1"
		}
	],

	// Service Binding —— 内部直连出题 AI Worker（不走公网，无需 URL 和令牌）
	"services": [
		{
			"binding": "AI_WORKER",
			"service": "we-learning-suite-ai"
		}
	],

	// 非敏感环境变量（敏感信息用 wrangler secret put 设置）
	"vars": {
		"APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
		"APPWRITE_PROJECT_ID": "6a6c7036001a06ffc393",
		"APPWRITE_FUNCTION_ID": "6a784dd9002e0069cf39"
	}

	{
		"previews": {
			"vars": {
				"APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
				"APPWRITE_FUNCTION_ID": "6a784dd9002e0069cf39",
				"APPWRITE_PROJECT_ID": "6a6c7036001a06ffc393"
			},
			"unsafe": {
				"bindings": [
					{
						"name": "AI_WORKER",
						"type": "service",
						"service": "we-learning-suite-ai",
						"environment": "production"
					}
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "3d5795c9-b196-4c0b-8226-d2ec845d0c05"
				}
			],
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "we-learning-suite-preview"
				}
			],
			"observability": {
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": true,
					"persist": true
				},
				"traces": {
					"enabled": false,
					"head_sampling_rate": 1,
					"persist": true
				}
			}
		}
	}


	// 以下变量通过 `npx wrangler secret put <NAME>` 设置，不写在配置文件里：
	// R2_ACCESS_KEY_ID     - R2 S3 API 的 Access Key（用于生成预签名 URL）
	// R2_SECRET_ACCESS_KEY - R2 S3 API 的 Secret Key
	// CLOUDFLARE_ACCOUNT_ID - 你的 Cloudflare Account ID（R2 S3 endpoint 需要）
}
